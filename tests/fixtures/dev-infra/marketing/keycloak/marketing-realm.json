{
  "realm": "marketing",
  "enabled": true,
  "displayName": "Marketing Platform Local Identity",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "marketing-admin", "description": "Local R1 platform administrator" },
      { "name": "marketing-reviewer", "description": "Local R1 governed reviewer" }
    ]
  },
  "clients": [
    {
      "clientId": "marketing-api",
      "name": "Marketing API audience",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "marketing-console",
      "name": "Marketing Operations Console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:4173/*"
      ],
      "webOrigins": ["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:4173", "http://127.0.0.1:4173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "marketing-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": { "included.client.audience": "marketing-api", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": { "claim.name": "tenant_id", "claim.value": "retail-cn", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true" }
        },
        {
          "name": "organization-scope",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": { "claim.name": "org_ids", "claim.value": "retail-business", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true" }
        },
        {
          "name": "shop-scope",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": { "claim.name": "shop_ids", "claim.value": "all-shops", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true" }
        },
        {
          "name": "permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": { "claim.name": "permissions", "claim.value": "*", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "R1",
      "lastName": "Operator",
      "email": "operator@marketing.local",
      "credentials": [{ "type": "password", "value": "local-operator-change-me", "temporary": false }],
      "realmRoles": ["marketing-admin"]
    }
  ]
}
