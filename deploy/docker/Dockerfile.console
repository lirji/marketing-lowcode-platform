# syntax=docker/dockerfile:1.7
FROM node:24.7.0-alpine3.22 AS build
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/packages/contracts frontend/packages/contracts
COPY frontend/apps/console frontend/apps/console
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm config set store-dir /pnpm/store \
    && pnpm install --frozen-lockfile \
    && pnpm frontend:build

FROM nginxinc/nginx-unprivileged:1.28.0-alpine AS runtime
LABEL org.opencontainers.image.title="marketing-console" \
      org.opencontainers.image.description="Governed marketing low-code operations console" \
      org.opencontainers.image.version="1.0.0"
COPY --from=build /workspace/frontend/apps/console/dist /usr/share/nginx/html
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/docker/config.js.template /etc/nginx/templates/config.js.template
COPY deploy/docker/security-headers.conf.template /etc/nginx/templates/security-headers.conf.template
USER root
RUN chown -R 101:101 /usr/share/nginx/html /etc/nginx/templates
ENV NGINX_ENVSUBST_OUTPUT_DIR=/etc/marketing-console
ENV CONSOLE_BENEFIT_ORIGIN=
ENV CONSOLE_RISK_ORIGIN=
USER 101
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
