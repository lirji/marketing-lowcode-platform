{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/marketing/manifest-changed/1-0-0",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "tenantId", "manifestId", "generation", "slotKey", "desiredState", "occurredAt"],
  "properties": {
    "eventId": {"type": "string"},
    "tenantId": {"type": "string"},
    "manifestId": {"type": "string"},
    "generation": {"type": "integer", "minimum": 1},
    "slotKey": {"type": "string"},
    "desiredState": {"enum": ["STAGED", "CANARY_READY", "ACTIVE", "PAUSED", "REVOKED"]},
    "occurredAt": {"type": "string", "format": "date-time"}
  }
}
