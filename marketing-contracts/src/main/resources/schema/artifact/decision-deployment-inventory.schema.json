{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/marketing/decision-deployment-inventory/1-0-0",
  "description": "Signed serving inventory for one Decision deployment slot. Instance IDs and execution key IDs must each be unique. An empty inventory records a drained slot. The observation expires within five minutes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment",
    "cell",
    "namespace",
    "sequence",
    "observedAt",
    "expiresAt",
    "replicas",
    "signatureKeyId",
    "signature"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "cell": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "replicas": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "instanceId",
          "imageDigest",
          "executionKeyId"
        ],
        "additionalProperties": false,
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "imageDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "executionKeyId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          }
        }
      }
    },
    "signatureKeyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
