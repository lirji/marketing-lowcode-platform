{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/marketing/release-manifest/1-0-0",
  "title": "Signed release desired state",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestId", "tenantId", "environment", "cell", "runtime", "namespace", "generation", "artifacts", "createdAt", "signature"],
  "properties": {
    "manifestId": {"type": "string"},
    "tenantId": {"type": "string"},
    "environment": {"type": "string"},
    "cell": {"type": "string"},
    "runtime": {"type": "string"},
    "namespace": {"type": "string"},
    "generation": {"type": "integer", "minimum": 1},
    "stableGeneration": {"type": "integer", "minimum": 0},
    "canaryGenerations": {"type": "array", "items": {"type": "integer"}},
    "retainedGenerations": {"type": "array", "items": {"type": "integer"}},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifactId", "uri", "checksum", "signature", "abi"],
        "properties": {
          "artifactId": {"type": "string"},
          "type": {"type": "string"},
          "uri": {"type": "string"},
          "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "signature": {"type": "string"},
          "abi": {"type": "string"}
        }
      }
    },
    "canaryBasisPoints": {"type": "integer", "minimum": 0, "maximum": 10000},
    "activationAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "createdAt": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "minLength": 1}
  }
}
