{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/marketing/graph-definition/1-0-0",
  "title": "Marketing low-code graph definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["definitionId", "dialect", "dialectVersion", "nodes", "edges"],
  "properties": {
    "definitionId": {"type": "string", "minLength": 1, "maxLength": 128},
    "dialect": {"enum": ["OFFER_DECISION_DAG", "AUDIENCE_EXPRESSION", "JOURNEY_STATE_MACHINE", "DMN_DECISION_TABLE", "BENEFIT_POLICY"]},
    "dialectVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "nodes": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stableTypeId", "semanticVersion", "config"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "stableTypeId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
          "semanticVersion": {"type": "string"},
          "config": {"type": "object", "additionalProperties": {"type": "string"}}
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceNodeId", "sourcePort", "targetNodeId", "targetPort"],
        "properties": {
          "id": {"type": "string"},
          "sourceNodeId": {"type": "string"},
          "sourcePort": {"type": "string"},
          "targetNodeId": {"type": "string"},
          "targetPort": {"type": "string"}
        }
      }
    },
    "variables": {"type": "object", "additionalProperties": {"type": "string"}},
    "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
