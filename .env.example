# Copy only for local development. scripts/bootstrap.sh creates a private .env with random secrets.
COMPOSE_PROJECT_NAME=marketing-r1
IMAGE_TAG=local
# Shared infrastructure lives in the sibling dev-infra project.
DEV_INFRA_NETWORK=dev-infra
MARKETING_MYSQL_HOST=infra-mysql84
MARKETING_KAFKA_BOOTSTRAP_SERVERS=infra-kafka38:9092
BENEFIT_CENTER_BASE_URL=http://127.0.0.1:8183
# AwardIntent 默认只记录 LEGACY；逐租户切 CENTER 前同时配置 M2M token 并开启 Relay。
BENEFIT_CENTER_BEARER_TOKEN=
RISK_PLATFORM_BASE_URL=http://host.docker.internal:8082
# OIDC/secure 模式必须配置具有 risk.evaluate 权限且 audience 属于 risk evaluation 的 M2M token。
RISK_PLATFORM_BEARER_TOKEN=
MARKETING_AWARD_DEFAULT_MODE=LEGACY
MARKETING_AWARD_TENANT_MODES=
MARKETING_AWARD_RELAY_ENABLED=false
MARKETING_AWARD_BULKHEAD_PERMITS=64
MARKETING_AWARD_RELAY_TENANT_BATCH_SIZE=10
MARKETING_AWARD_RELAY_CIRCUIT_FAILURE_THRESHOLD=5
MARKETING_AWARD_RELAY_CIRCUIT_OPEN_MS=30000
# Placeholder used only for manifest validation; runtime scripts derive the
# actual shared password from dev-infra/.env without copying it here.
DEV_INFRA_REDIS_URL=redis://:replace-with-dev-infra-redis-password@infra-redis7:6379
# Optional host-only overrides for Marketing-dedicated services.
# GATEWAY_PORT=18080
# CONSOLE_PORT=13000
# FLINK_UI_PORT=18081
MARKETING_SECURITY_MODE=DEV
MARKETING_DEV_HEADERS_ENABLED=true
MARKETING_OBSERVABILITY_ENABLED=false
CONSOLE_DEMO_MODE=false
CONSOLE_AUTH_MODE=DEV
CONSOLE_ALLOW_DEV_AUTH=true
CONSOLE_API_BASE_URL=
CONSOLE_OIDC_AUTHORITY=http://host.docker.internal:8180/realms/marketing
CONSOLE_OIDC_CLIENT_ID=marketing-console
CONSOLE_OIDC_ORGANIZATION=
CONSOLE_OIDC_SCOPE="openid profile email"
CONSOLE_OIDC_ORIGIN=http://host.docker.internal:8180
# Optional. Empty hides cross-console links to benefit-center.
# CONSOLE_BENEFIT_ORIGIN=http://127.0.0.1:8083
# Optional. Empty hides cross-console links to risk-console decisions.
# CONSOLE_RISK_ORIGIN=http://127.0.0.1:15173
CONSOLE_HSTS_LINE=
MARKETING_DB_PASSWORD=replace-with-random-value
CONTROL_DB_PASSWORD=replace-with-random-value
CONTROL_MIGRATION_DB_PASSWORD=replace-with-random-value
COMPILER_DB_PASSWORD=replace-with-random-value
COMPILER_MIGRATION_DB_PASSWORD=replace-with-random-value
AUDIENCE_DB_PASSWORD=replace-with-random-value
AUDIENCE_MIGRATION_DB_PASSWORD=replace-with-random-value
DECISION_DB_PASSWORD=replace-with-random-value
DECISION_MIGRATION_DB_PASSWORD=replace-with-random-value
BENEFIT_DB_PASSWORD=replace-with-random-value
BENEFIT_MIGRATION_DB_PASSWORD=replace-with-random-value
EVENTS_DB_PASSWORD=replace-with-random-value
EVENTS_MIGRATION_DB_PASSWORD=replace-with-random-value
JOURNEY_DB_PASSWORD=replace-with-random-value
JOURNEY_MIGRATION_DB_PASSWORD=replace-with-random-value
ENGAGEMENT_DB_PASSWORD=replace-with-random-value
ENGAGEMENT_MIGRATION_DB_PASSWORD=replace-with-random-value
MEASUREMENT_DB_PASSWORD=replace-with-random-value
MEASUREMENT_MIGRATION_DB_PASSWORD=replace-with-random-value
KEYCLOAK_DB_PASSWORD=replace-with-random-value
KEYCLOAK_ADMIN_PASSWORD=replace-with-random-value
GRAFANA_ADMIN_PASSWORD=replace-with-random-value
OFFER_SIGNING_KEY_ID=offer-local-example
OFFER_SIGNING_PRIVATE_KEY_BASE64=
OFFER_SIGNING_PUBLIC_KEY_BASE64=
OFFER_TRUSTED_PUBLIC_KEYS=
RELEASE_SIGNING_KEY_ID=release-local-example
RELEASE_SIGNING_PRIVATE_KEY_BASE64=
RELEASE_SIGNING_PUBLIC_KEY_BASE64=
RELEASE_TRUSTED_PUBLIC_KEYS=
COMPILER_SIGNING_KEY_ID=compiler-local-example
COMPILER_SIGNING_PRIVATE_KEY_BASE64=
COMPILER_SIGNING_PUBLIC_KEY_BASE64=
COMPILER_TRUSTED_PUBLIC_KEYS=
RUNTIME_ACK_SIGNING_KEY_ID=runtime-local-example
RUNTIME_ACK_SIGNING_PRIVATE_KEY_BASE64=
RUNTIME_ACK_SIGNING_PUBLIC_KEY_BASE64=
RUNTIME_ACK_TRUSTED_PUBLIC_KEYS=
MARKETING_ROUTING_SECRET=replace-with-random-value
